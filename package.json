{
  "name": "@rmrk-team/evm-contracts",
  "version": "2.5.3",
  "license": "Apache-2.0",
  "files": [
    "contracts/RMRK/*",
    "contracts/implementations/*"
  ],
  "scripts": {
    "test": "TS_NODE_PROJECT=tsconfig.hardhat.json hardhat typechain && TS_NODE_PROJECT=tsconfig.hardhat.json hardhat test",
    "coverage": "TS_NODE_PROJECT=tsconfig.hardhat.json hardhat typechain && TS_NODE_PROJECT=tsconfig.hardhat.json hardhat coverage",
    "typechain": "TS_NODE_PROJECT=tsconfig.hardhat.json hardhat typechain",
    "build:artifacts": "TS_NODE_PROJECT=tsconfig.hardhat.json hardhat compile && bun ./scripts/generate-abis.ts",
    "docs:prepare": "TS_NODE_PROJECT=tsconfig.hardhat.json hardhat dodoc && bun ./scripts/generate-docs-site.ts",
    "docs:dev": "bun run docs:prepare && next dev",
    "docs:build": "bun run docs:prepare && next build && next export",
    "prettier": "prettier --write .",
    "prepare:commit": "bun run docs:build && prettier --write ."
  },
  "engines": {
    "bun": ">=1.1.0"
  },
  "packageManager": "bun@1.3.4",
  "dependencies": {
    "@openzeppelin/contracts": "^5.0.2"
  },
  "devDependencies": {
    "clsx": "^2.0.0",
    "@nomicfoundation/hardhat-chai-matchers": "^2.0.3",
    "@nomicfoundation/hardhat-ethers": "^3.0.5",
    "@nomicfoundation/hardhat-network-helpers": "^1.0.10",
    "@nomicfoundation/hardhat-toolbox": "^4.0.0",
    "@nomicfoundation/hardhat-verify": "^2.0.3",
    "@primitivefi/hardhat-dodoc": "^0.2.3",
    "@typechain/ethers-v6": "^0.5.1",
    "@typechain/hardhat": "^9.1.0",
    "@types/chai": "^4.3.11",
    "@types/mocha": "^10.0.6",
    "@types/node": "^20.11.7",
    "@typescript-eslint/eslint-plugin": "^6.19.1",
    "@typescript-eslint/parser": "^6.19.1",
    "chai": "^4.4.1",
    "dotenv": "^16.4.1",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-config-standard": "^17.1.0",
    "eslint-import-resolver-typescript": "^3.6.1",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-n": "^16.6.2",
    "eslint-plugin-prettier": "^5.1.3",
    "eslint-plugin-promise": "^6.1.1",
    "ethers": "^6.10.0",
    "hardhat": "^2.19.4",
    "hardhat-contract-sizer": "^2.10.0",
    "hardhat-gas-reporter": "^1.0.9",
    "next": "13.0.6",
    "nextra": "2.13.2",
    "nextra-theme-docs": "2.13.2",
    "prettier": "^3.2.4",
    "prettier-plugin-solidity": "^1.3.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-icons": "^4.12.0",
    "rimraf": "^5.0.5",
    "solc": "0.8.21",
    "solidity-coverage": "0.8.6-sha1.0",
    "squirrelly": "^9.0.0",
    "ts-node": "11.0.0-beta.1",
    "typechain": "^8.3.2",
    "typescript": "^5.3.3",
    "walk-sync": "^3.0.0"
  }
}
