{
  "compilerOptions": {
    "baseUrl": ".",
    "target": "es2020",
    "moduleResolution": "node",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": false,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "incremental": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "module": "esnext",
    "resolveJsonModule": true,
    "paths": {
      "@components/*": ["components/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "pages/**/*.ts",
    "pages/**/*.tsx",
    "pages/**/*.mdx",
    "components/**/*.ts",
    "components/**/*.tsx",
    "theme.config.tsx"
  ],
  "exclude": ["node_modules", "dist", "artifacts", "cache", "test", "scripts", "typechain-types"]
}
